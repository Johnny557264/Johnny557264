---------------------------------------------------------------------
-- อัปเดตข้อความปุ่ม Boost / Mode / Theme
---------------------------------------------------------------------
local function refreshButtonsText()
    toggleButton.Text = FPSBoostEnabled and "ปิด Boost" or "เปิด Boost"

    if FPSBoostMode == MODE_EXTREME then
        modeButton.Text = "โหมด Boost: ประหยัดสุด ๆ"
    else
        modeButton.Text = "โหมด Boost: กลาง ๆ"
    end

    themeButton.Text = "Theme: " .. currentTheme
end

toggleButton.MouseButton1Click:Connect(function()
    FPSBoostEnabled = not FPSBoostEnabled
    refreshButtonsText()
    if FPSBoostEnabled then
        optimizeLighting()
        fullScan()
    end
end)

modeButton.MouseButton1Click:Connect(function()
    if FPSBoostMode == MODE_EXTREME then
        FPSBoostMode = MODE_MEDIUM
    else
        FPSBoostMode = MODE_EXTREME
    end

    refreshButtonsText()
    if FPSBoostEnabled then
        optimizeLighting()
        fullScan()
    end
end)

-- สลับ Theme
local themeOrder = {
    THEME_RAINBOW,
    THEME_DARK,
    THEME_LIGHT,
    THEME_NEON,
    THEME_STATIC,
}
local function cycleTheme()
    local index
    for i, v in ipairs(themeOrder) do
        if v == currentTheme then
            index = i
            break
        end
    end
    index = (index % #themeOrder) + 1
    currentTheme = themeOrder[index]
    refreshButtonsText()
end

themeButton.MouseButton1Click:Connect(function()
    cycleTheme()
end)

---------------------------------------------------------------------
-- FPS Counter + Theme Updater (RenderStepped)
---------------------------------------------------------------------
local fpsSmoothing = 0
local alpha = 0.1
local rainbowHue = 0
local rainbowSpeed = 0.2 -- ยิ่งเยอะยิ่งวิ่งเร็ว

RunService.RenderStepped:Connect(function(dt)
    -- FPS Counter
    local currentFPS = 1 / math.max(dt, 1/240)
    if fpsSmoothing == 0 then
        fpsSmoothing = currentFPS
    else
        fpsSmoothing = fpsSmoothing + (currentFPS - fpsSmoothing) * alpha
    end
    if fpsLabel.Visible then
        fpsLabel.Text = string.format("FPS: %d", math.floor(fpsSmoothing + 0.5))
    end

    -- Theme Update
    local baseColor
    local textColor = Color3.new(1, 1, 1)

    if currentTheme == THEME_RAINBOW then
        rainbowHue = (rainbowHue + dt * rainbowSpeed) % 1
        baseColor = Color3.fromHSV(rainbowHue, 1, 1)
        textColor = Color3.new(1, 1, 1)

    elseif currentTheme == THEME_DARK then
        baseColor = Color3.fromRGB(25, 25, 25)
        textColor = Color3.new(1, 1, 1)

    elseif currentTheme == THEME_LIGHT then
        baseColor = Color3.fromRGB(230, 230, 230)
        textColor = Color3.new(0, 0, 0)

    elseif currentTheme == THEME_NEON then
        baseColor = Color3.fromRGB(0, 255, 170)
        textColor = Color3.new(0, 0, 0)

    elseif currentTheme == THEME_STATIC then
        baseColor = staticColor
        textColor = Color3.new(1, 1, 1)
    end

    -- เอาสี Theme ใส่ UI
    frame.BackgroundColor3       = baseColor
    toggleButton.BackgroundColor3= baseColor
    modeButton.BackgroundColor3  = baseColor
    themeButton.BackgroundColor3 = baseColor
    fpsLabel.BackgroundColor3    = baseColor
    uiToggleButton.BackgroundColor3 = baseColor

    title.TextColor3         = textColor
    toggleButton.TextColor3  = textColor
    modeButton.TextColor3    = textColor
    themeButton.TextColor3   = textColor
    fpsLabel.TextColor3      = textColor
    uiToggleButton.TextColor3= textColor
end)

