---------------------------------------------------------------------
-- ฟังก์ชันลดงาน Lighting
---------------------------------------------------------------------
local function optimizeLighting()
    if not FPSBoostEnabled then return end

    if FPSBoostMode == MODE_EXTREME then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.EnvironmentDiffuseScale  = 0
            Lighting.EnvironmentSpecularScale = 0
            Lighting.Brightness = 1
        end)
    elseif FPSBoostMode == MODE_MEDIUM then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.EnvironmentDiffuseScale  = 0.2
            Lighting.EnvironmentSpecularScale = 0.1
            Lighting.Brightness = 1.5
        end)
    end
end

---------------------------------------------------------------------
-- ฟังก์ชันปิด Effect / ลบ Texture ตามโหมด
---------------------------------------------------------------------
local function handleInstance(obj)
    if not FPSBoostEnabled then return end

    -- ปิดเอฟเฟกต์กินเครื่อง
    if obj:IsA("ParticleEmitter")
    or obj:IsA("Trail")
    or obj:IsA("Beam")
    or obj:IsA("Smoke")
    or obj:IsA("Fire")
    or obj:IsA("Sparkles") then
        obj.Enabled = false

    elseif FPSBoostMode == MODE_EXTREME then
        -- ลบ Texture / Decal / SurfaceAppearance ในโหมดประหยัดสุด ๆ
        if obj:IsA("Decal")
        or obj:IsA("Texture")
        or obj:IsA("SurfaceAppearance") then
            obj:Destroy()
        end
    end

    if obj:IsA("Explosion") then
        obj.Visible = false
    end
end

---------------------------------------------------------------------
-- สแกนทั้งแมพครั้งแรก
---------------------------------------------------------------------
local function fullScan()
    if not FPSBoostEnabled then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        handleInstance(obj)
    end

    for _, obj in ipairs(Lighting:GetDescendants()) do
        handleInstance(obj)
    end
end

-- ดูของใหม่ที่สร้างในภายหลัง
Workspace.DescendantAdded:Connect(handleInstance)
Lighting.DescendantAdded:Connect(handleInstance)

